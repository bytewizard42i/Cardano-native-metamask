{
  "name": "@cmm/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, constants, and utilities for CMM packages",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo '(shared: no lint yet)'",
    "test": "echo '(shared: no tests yet)'"
  }
}
