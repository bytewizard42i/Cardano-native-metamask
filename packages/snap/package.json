{
  "name": "@cmm/snap",
  "version": "0.0.0",
  "private": true,
  "description": "CMM MetaMask Snap — Cardano + Midnight key derivation and signing",
  "license": "Apache-2.0",
  "main": "./dist/bundle.js",
  "files": ["dist", "images", "snap.manifest.json"],
  "scripts": {
    "build": "mm-snap build",
    "build:clean": "pnpm clean && pnpm build",
    "dev": "mm-snap watch",
    "serve": "mm-snap serve",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo '(snap: lint TBD with @metamask/eslint-config-snaps)'",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:integration": "jest --config integration-test/jest.config.integration.cjs --runInBand",
    "manifest": "mm-snap manifest"
  },
  "dependencies": {
    "@cmm/shared": "workspace:*",
    "@metamask/key-tree": "^10.1.1",
    "@metamask/snaps-sdk": "^10.3.0",
    "@metamask/utils": "^11.9.0",
    "@noble/hashes": "^1.5.0",
    "bech32": "^2.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "@metamask/snaps-cli": "^8.3.0",
    "@metamask/snaps-jest": "^9.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.0.5",
    "jest-mock-extended": "^4.0.0",
    "ts-jest": "^29.4.1"
  }
}
