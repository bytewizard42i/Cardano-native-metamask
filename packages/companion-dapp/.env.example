# ---------------------------------------------------------------------------
# CMM companion-dapp environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in values.
# Only variables prefixed with `VITE_` are exposed to the browser.
#
# ⚠️ Never commit `.env.local`. Never put mainnet secrets here.
# ---------------------------------------------------------------------------

# Blockfrost project_id for Cardano preprod testnet.
# Get one free at https://blockfrost.io/dashboard (tier: "Free", project: "preprod").
# Required for the "Live data" toggle on Cardano cards.
VITE_BLOCKFROST_PROJECT_ID_CARDANO_PREPROD=

# Optional: mainnet project_id. Left blank for M0–M5; populate for production.
VITE_BLOCKFROST_PROJECT_ID_CARDANO_MAINNET=

# Optional: Blockfrost proxy URL (e.g. https://cmm-proxy.vercel.app/api/blockfrost/preprod).
# When set, the dApp routes Cardano queries through the proxy instead of calling
# Blockfrost directly — the project_id stays server-side, never shipped to the browser.
# Use this in production. For local dev, the direct project_id above is fine.
# Deploy: see apps/proxy/README.md
VITE_BLOCKFROST_PROXY_URL_CARDANO_PREPROD=

# A publicly-known Cardano preprod address to query in live-readonly mode.
# Use your own testnet wallet, or any address you want to display.
# Example format: addr_test1qp...
VITE_DEMO_CARDANO_ADDRESS=

# Optional: Midnight testnet-02 address for the M2+ viewing-key-aware flow.
# Leave blank in M1 (Midnight balances remain mock-only until Snap lands).
VITE_DEMO_MIDNIGHT_ADDRESS=

# Optional: override Midnight indexer URL. Default:
#   https://indexer.testnet-02.midnight.network/api/v1/graphql
VITE_MIDNIGHT_INDEXER_URL=

# Adapter mode override. Values: 'mock' | 'live-readonly' | 'auto' | 'real'.
# Default: the UI toggle decides. Set here to force one mode for demos.
VITE_CMM_ADAPTER_MODE=
