{
  "name": "@cmm/dapp-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "dApp-side SDK for integrating with the CMM Snap (with mock adapter for dev/demo)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./mock": { "types": "./dist/adapters/mock.d.ts", "import": "./dist/adapters/mock.js" },
    "./real": { "types": "./dist/adapters/real.d.ts", "import": "./dist/adapters/real.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo '(dapp-sdk: lint TBD)'",
    "test": "echo '(dapp-sdk: vitest to come)'"
  },
  "dependencies": {
    "@cmm/shared": "workspace:*"
  }
}
