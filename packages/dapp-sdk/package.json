{
  "name": "@cmm/dapp-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "dApp-side SDK for integrating with the CMM Snap (with mock adapter for dev/demo)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./mock": { "types": "./src/adapters/mock.ts", "import": "./src/adapters/mock.ts" },
    "./real": { "types": "./src/adapters/real.ts", "import": "./src/adapters/real.ts" }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo '(dapp-sdk: lint TBD)'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cmm/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
